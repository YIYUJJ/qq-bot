{
  "name": "@dsh-external/dsh-qq-bot",
  "version": "0.1.0",
  "type": "module",
  "description": "QQ 群拟人聊天机器人（DSH Cordis 插件）：直连 SnowLuma OneBot v11，进程内流式调用，自带 Web 控制台与长期记忆",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "panel",
    "scripts",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "AGENTS.md",
    "LICENSE",
    "build-client.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:policy": "node lib/test-policy.mjs",
    "test:outbox": "node lib/test-outbox.mjs",
    "test:roomcfg": "node lib/test-roomcfg.mjs",
    "test:text": "node lib/test-text.mjs",
    "test:extras": "node lib/test-extras.mjs",
    "smoke": "node scripts/smoke.mjs",
    "scan:static": "node tools/static-scan.cjs",
    "build:client": "node build-client.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "qq",
    "qq-bot",
    "onebot",
    "snowluma",
    "llm",
    "chatbot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-name>/qq-bot.git"
  },
  "bugs": {
    "url": "https://github.com/<your-name>/qq-bot/issues"
  },
  "homepage": "https://github.com/<your-name>/qq-bot#readme"
}
